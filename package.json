{
  "name": "tributes-bio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.1",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:prod",
    "build:dev": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "deploy:dev": "npm run build:dev && firebase deploy --project dev --only hosting",
    "deploy:prod": "npm run build:prod && firebase deploy --project prod --only hosting",
    "emulators": "firebase emulators:start --project dev",
    "lint": "tsc -b --pretty false",
    "lint:js": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "spin-wheel": "4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "10.5.4",
    "eslint": "^9.31.0",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "tailwindcss": "3.4.19",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  }
}
