rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function publicCreatorFields() {
      return [
        'ownerUid',
        'username',
        'displayName',
        'bio',
        'photoPath',
        'photoURL',
        'appearance',
        'isPublished',
        'moderationStatus',
        'createdAt',
        'updatedAt'
      ];
    }

    function validPublicCreator() {
      return request.resource.data.keys().hasOnly(publicCreatorFields())
        && request.resource.data.ownerUid is string
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.isPublished is bool
        && request.resource.data.appearance is map
        && request.resource.data.appearance.keys().hasOnly(['hue', 'tone'])
        && request.resource.data.appearance.hue is int
        && request.resource.data.appearance.hue >= 0
        && request.resource.data.appearance.hue <= 345
        && request.resource.data.appearance.tone is int
        && request.resource.data.appearance.tone >= 0
        && request.resource.data.appearance.tone <= 100;
    }

    function validCreatorLink() {
      return request.resource.data.keys().hasOnly([
          'title',
          'url',
          'position',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('^https?://.*')
        && request.resource.data.position is int
        && request.resource.data.position >= 0
        && request.resource.data.isActive is bool;
    }

    function validSpinConfig(creatorId) {
      return request.resource.data.keys().hasOnly([
          'creatorId',
          'name',
          'archived',
          'availableToViewers',
          'isDefault',
          'activeWheelId',
          'createdAt',
          'title',
          'counterLabel',
          'spinPriceCents',
          'maxChargeCents',
          'spinsPerPurchase',
          'isEnabled',
          'showOnProfile',
          'mockModeEnabled',
          'wheelHue',
          'wheelTone',
          'goalCents',
          'slices',
          'updatedAt'
        ])
        && request.resource.data.creatorId == creatorId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.archived is bool
        && (!('availableToViewers' in request.resource.data)
          || request.resource.data.availableToViewers is bool)
        && (!('isDefault' in request.resource.data)
          || request.resource.data.isDefault is bool)
        // Only the active document carries a pointer, and only ever to a string id.
        && (!('activeWheelId' in request.resource.data)
          || request.resource.data.activeWheelId is string)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.counterLabel is string
        && request.resource.data.counterLabel.size() > 0
        && request.resource.data.counterLabel.size() <= 40
        && request.resource.data.spinPriceCents is int
        && request.resource.data.spinPriceCents >= 100
        && request.resource.data.spinPriceCents <= 100000
        // The ceiling a run can reach. Older wheels predate it and merge
        // through without one.
        && (!('maxChargeCents' in request.resource.data)
          || (request.resource.data.maxChargeCents is int
            && request.resource.data.maxChargeCents >= 100
            && request.resource.data.maxChargeCents <= 500000))
        // Spins a purchase buys. Older wheels predate it and sell one.
        && (!('spinsPerPurchase' in request.resource.data)
          || (request.resource.data.spinsPerPurchase is int
            && request.resource.data.spinsPerPurchase >= 1
            && request.resource.data.spinsPerPurchase <= 10))
        && request.resource.data.isEnabled is bool
        && request.resource.data.showOnProfile is bool
        && request.resource.data.mockModeEnabled is bool
        && request.resource.data.wheelHue is int
        && request.resource.data.wheelHue >= 0
        && request.resource.data.wheelHue <= 345
        && request.resource.data.wheelTone is int
        && request.resource.data.wheelTone >= 0
        && request.resource.data.wheelTone <= 100
        // Legacy field: the goal moved to spinSettings, so documents written
        // now omit it while older ones still carry it through a merge.
        && (!('goalCents' in request.resource.data)
          || (request.resource.data.goalCents is int
            && request.resource.data.goalCents >= 0
            && request.resource.data.goalCents <= 10000000))
        && request.resource.data.slices is list
        && request.resource.data.slices.size() >= 2
        && request.resource.data.slices.size() <= 12;
    }

    function publicSpinAvailable(creatorId) {
      return get(/databases/$(database)/documents/creators/$(creatorId)).data.isPublished == true
        && get(/databases/$(database)/documents/creators/$(creatorId)).data.moderationStatus == 'active'
        && get(/databases/$(database)/documents/creators/$(creatorId)/spinConfigs/current).data.isEnabled == true;
    }

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsCreator(creatorId) {
      return signedIn()
        && get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, create: if owns(uid);
      allow update: if owns(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'accountStatus',
          'accountStatusReason'
        ]);
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /creators/{creatorId} {
      allow read: if (resource.data.isPublished == true
          && resource.data.moderationStatus == 'active')
        || owns(resource.data.ownerUid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && creatorId == request.auth.uid
        && request.resource.data.moderationStatus == 'active'
        && validPublicCreator();
      allow update: if owns(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.username == resource.data.username
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && validPublicCreator();

      match /links/{linkId} {
        allow read: if (resource.data.isActive == true
            && get(/databases/$(database)/documents/creators/$(creatorId)).data.isPublished == true
            && get(/databases/$(database)/documents/creators/$(creatorId)).data.moderationStatus == 'active')
          || owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid);
        allow create, update: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          && validCreatorLink();
        allow delete: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid);
      }

      match /spinConfigs/{configId} {
        allow read: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          || (get(/databases/$(database)/documents/creators/$(creatorId)).data.isPublished == true
            && get(/databases/$(database)/documents/creators/$(creatorId)).data.moderationStatus == 'active'
            && (resource.data.availableToViewers == true
              || (configId == 'current' && resource.data.isEnabled == true)));
        allow create, update: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          && validSpinConfig(creatorId);
        allow delete: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid);
      }

      // The tribute goal is creator-level, shared by every wheel.
      match /spinSettings/{settingsId} {
        allow read: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          || (settingsId == 'current' && publicSpinAvailable(creatorId));
        allow create, update: if settingsId == 'current'
          && owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          && request.resource.data.keys().hasOnly([
            'creatorId', 'label', 'goalCents',
            'soundEnabled', 'soundVolume', 'soundSpin', 'soundTick',
            'soundResult', 'soundWin', 'soundQueue',
            'queueMaxVisible', 'queueHideNames',
            'updatedAt'
          ])
          && request.resource.data.creatorId == creatorId
          // Goal and overlay settings share this document and are written
          // independently, so each group is only checked when present.
          && (!('label' in request.resource.data)
            || (request.resource.data.label is string
              && request.resource.data.label.size() > 0
              && request.resource.data.label.size() <= 40))
          && (!('goalCents' in request.resource.data)
            || (request.resource.data.goalCents is int
              && request.resource.data.goalCents >= 0
              && request.resource.data.goalCents <= 10000000))
          && (!('soundVolume' in request.resource.data)
            || (request.resource.data.soundVolume is int
              && request.resource.data.soundVolume >= 0
              && request.resource.data.soundVolume <= 100))
          && (!('queueMaxVisible' in request.resource.data)
            || (request.resource.data.queueMaxVisible is int
              && request.resource.data.queueMaxVisible >= 1
              && request.resource.data.queueMaxVisible <= 10));
        allow delete: if false;
      }

      match /spinQueue/{entryId} {
        allow read: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          || publicSpinAvailable(creatorId);
        allow write: if false;
      }

      match /spinStates/{stateId} {
        allow read: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          || (stateId == 'current' && publicSpinAvailable(creatorId));
        allow write: if false;
      }

      match /spinSessions/{sessionId} {
        allow read: if owns(get(/databases/$(database)/documents/creators/$(creatorId)).data.ownerUid)
          || (sessionId == 'current'
            && get(/databases/$(database)/documents/creators/$(creatorId)).data.isPublished == true
            && get(/databases/$(database)/documents/creators/$(creatorId)).data.moderationStatus == 'active');
        allow write: if false;
      }
    }

    match /spinReceipts/{receiptId} {
      allow read: if receiptId.size() >= 24;
      allow write: if false;
    }

    match /creatorSettings/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.ownerUid == uid;
      allow delete: if owns(uid);
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    match /twitchConnections/{creatorId} {
      allow read, write: if false;
    }

    match /twitchBroadcasters/{broadcasterId} {
      allow read, write: if false;
    }

    match /twitchOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /twitchEvents/{eventId} {
      allow read, write: if false;
    }

    match /contentReports/{reportId} {
      allow read, write: if false;
    }

    match /reportRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{auditId} {
      allow read, write: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read, write: if false;
    }

    match /creatorAnalytics/{creatorId} {
      allow read: if ownsCreator(creatorId);
      allow write: if false;

      match /{document=**} {
        allow read: if ownsCreator(creatorId);
        allow write: if false;
      }
    }
  }
}
